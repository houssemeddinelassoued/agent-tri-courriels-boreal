# Copiez ce fichier en .env pour changer les réglages par défaut.

# Modèle Ollama utilisé pour l'extraction (doit être installé : ollama pull <modèle>)
OLLAMA_MODEL=gemma4
OLLAMA_BASE_URL=http://localhost:11434
# Version web (Streamlit Cloud) : Ollama du poste joint par un tunnel ngrok protégé par mot de passe.
# À mettre dans les « Secrets » de Streamlit Cloud, pas ici :
#   OLLAMA_BASE_URL = "https://boreal:MOT_DE_PASSE@VOTRE-DOMAINE.ngrok-free.dev"
# Fenêtre de contexte : 8 192 jetons suffisent pour un courriel et gardent le modèle sur un GPU de 8 Go
OLLAMA_NUM_CTX=8192

# Garde-fou codé dans l'outil accorder_credit (en dollars)
PLAFOND_CREDIT=500
